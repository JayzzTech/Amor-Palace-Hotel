{% extends 'base.html.twig' %}
{% block title %}Front desk · {{ branch.name }}{% endblock %}
{% block body %}
<div class="wrap dashboard-page front-desk-dashboard">
    <div class="dash-head dashboard-heading row-between">
        <div><p class="eyebrow dark">Operations</p><h1>Front desk, {{ branch.name }}</h1>
            <p class="muted">{{ is_granted('ROLE_ADMIN') ? 'Branch admin' : 'Staff' }} view. Manage arrivals, stays and rooms for this branch.</p></div>
        {% if is_granted('ROLE_SUPER_ADMIN') %}<a class="btn btn-ghost" href="{{ path('app_super') }}">Back to super admin</a>{% endif %}
    </div>
    <div class="stats">
        <div class="stat"><b>{{ stats.arrivals }}</b><span>Arrivals today</span></div>
        <div class="stat"><b>{{ stats.inhouse }}</b><span>Guests in house</span></div>
        <div class="stat"><b>{{ stats.pending }}</b><span>Awaiting confirmation</span></div>
        <div class="stat"><b>₱{{ stats.revenue|number_format }}</b><span>Booked revenue</span></div>
    </div>

    <div class="panel dashboard-panel">
        <div class="panel-heading"><div><span class="panel-kicker">Bookings</span><h3>Reservations</h3></div><span class="live-count">{{ reservations|length }} shown</span></div>
        <div class="filters">
            <a href="{{ path('app_staff', {branch: branch.id, q: query}) }}" class="{{ status ? '' : 'on' }}">All</a>
            {% for s in ['pending','confirmed','checked_in','checked_out','cancelled'] %}
                <a href="{{ path('app_staff', {branch: branch.id, status: s, q: query}) }}" class="{{ status == s ? 'on' : '' }}">{{ s|replace({'_':' '})|capitalize }}</a>
            {% endfor %}
        </div>
        <form class="dashboard-search" method="get" action="{{ path('app_staff') }}">
            <input type="hidden" name="branch" value="{{ branch.id }}">
            {% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
            <label class="sr-only" for="reservation-search">Search reservations</label>
            <input id="reservation-search" type="search" name="q" value="{{ query }}" placeholder="Search reference, guest, email or room" autocomplete="off">
            <button class="btn btn-ghost btn-sm" type="submit">Search</button>
            {% if query %}<a class="btn btn-ghost btn-sm" href="{{ path('app_staff', {branch: branch.id, status: status}) }}">Clear</a>{% endif %}
        </form>
        <div class="table-scroll-hint">Scroll horizontally to view all reservation details <span aria-hidden="true">→</span></div>
        <div class="table-wrap reservation-table-wrap">
        {% if reservations %}
        <table>
            <thead><tr><th>Reference</th><th>Guest</th><th>Room</th><th>Dates</th><th>Total</th><th>Status</th><th>Extend</th><th>Actions</th></tr></thead>
            <tbody>
            {% for r in reservations %}
                <tr>
                    <td><b>{{ r.reference }}</b><span class="muted small reservation-guest-label">Booking</span></td>
                    <td>{{ r.guest.fullName }}<br><span class="muted small">{{ r.guest.email }}</span></td>
                    <td>{{ r.room.number }}, {{ r.room.type }}</td>
                    <td><strong>{{ r.checkIn|date('d M Y') }}</strong><span class="stay-arrow">→</span><strong>{{ r.checkOut|date(r.nights > 0 ? 'd M Y' : 'd M Y, H:i') }}</strong><br><span class="muted small">{{ r.nights > 0 ? r.nights ~ ' ' ~ (r.nights == 1 ? 'night' : 'nights') : r.durationHours ~ ' hours' }} · {{ r.guests }} {{ r.guests == 1 ? 'guest' : 'guests' }}</span></td>
                    <td>₱{{ r.total|number_format }}</td>
                    <td><span class="badge badge-{{ r.status }}">{{ r.status|replace({'_': ' '})|capitalize }}</span></td>
                    <td class="reservation-extend">
                        {% if r.status in ['confirmed', 'checked_in'] %}
                        <details class="extend-stay">
                            <summary class="btn btn-ghost btn-sm">Extend stay</summary>
                            <form method="post" action="{{ path('app_staff_extend', {id: r.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('app') }}">
                                <div class="extension-fields">
                                    <div><label for="amount-{{ r.id }}">Amount</label><input id="amount-{{ r.id }}" type="number" name="amount" min="1" max="72" value="1" required></div>
                                    <div><label for="unit-{{ r.id }}">Unit</label><select id="unit-{{ r.id }}" name="unit" data-extension-unit><option value="hours">Hours</option><option value="days">Days</option></select></div>
                                </div>
                                <button class="btn btn-sm">Apply extension</button>
                                {% if r.extendedHours > 0 %}<small class="extension-note">Total extension: {{ r.extendedHours }} hours</small>{% endif %}
                            </form>
                        </details>
                        {% else %}<span class="muted small">—</span>{% endif %}
                    </td>
                    <td class="reservation-actions">
                        {% for next in r.nextStatuses %}
                        <form class="inline" method="post" action="{{ path('app_staff_status', {id: r.id}) }}" data-confirm="{{ {confirmed:'Confirm', checked_in:'Check in', checked_out:'Check out', cancelled:'Cancel'}[next] }} reservation {{ r.reference }}?">
                            <input type="hidden" name="_token" value="{{ csrf_token('app') }}">
                            <input type="hidden" name="status" value="{{ next }}">
                            <button class="btn btn-sm {{ next == 'cancelled' ? 'btn-danger' : '' }}">{{ {confirmed:'Confirm', checked_in:'Check in', checked_out:'Check out', cancelled:'Cancel'}[next] }}</button>
                        </form>
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}<p>No reservations match this filter.</p>{% endif %}
        </div>
    </div>

    <div class="panel dashboard-panel">
        <div class="panel-heading"><div><span class="panel-kicker">Inventory</span><h3>Rooms</h3></div></div>
        <div class="table-wrap inventory-table-wrap {{ is_granted('ROLE_ADMIN') ? 'inventory-table-admin' : 'inventory-table-staff' }}"><table>
            <thead><tr><th>Room</th><th>Type</th><th>Sleeps</th><th>Nightly rate</th><th>Open for booking</th>{% if is_granted('ROLE_ADMIN') %}<th></th>{% endif %}</tr></thead>
            <tbody>
            {% for room in rooms %}
                <tr>
                    <td><b>{{ room.number }}</b>{% if is_granted('ROLE_ADMIN') %}<form method="post" action="{{ path('app_staff_room_update', {id: room.id}) }}" id="rf{{ room.id }}"></form>{% endif %}</td><td>{{ room.type }}</td><td>{{ room.capacity }}</td>
                    {% if is_granted('ROLE_ADMIN') %}
                    <td><input form="rf{{ room.id }}" type="number" name="price" min="1" value="{{ room.pricePerNight }}" style="width:120px" aria-label="Nightly rate for room {{ room.number }}"></td>
                    <td><label class="room-open-toggle" style="margin:0"><input form="rf{{ room.id }}" type="checkbox" name="active" value="1" {{ room.active ? 'checked' : '' }} {{ room.activeBooking ? 'disabled' : '' }}> <span>{{ room.activeBooking ? 'Booked' : 'Open' }}</span></label></td>
                    <td><input form="rf{{ room.id }}" type="hidden" name="_token" value="{{ csrf_token('app') }}"><button form="rf{{ room.id }}" class="btn btn-ghost btn-sm">Save</button></td>
                    {% else %}
                    <td>₱{{ room.pricePerNight|number_format }}</td><td>{{ room.active ? 'Open' : 'Closed' }}</td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table></div>
        {% if is_granted('ROLE_ADMIN') %}
        <details><summary>Add a room</summary>
            <form method="post" action="{{ path('app_staff_room_new') }}" class="grid-form" style="margin-top:1rem">
                <input type="hidden" name="_token" value="{{ csrf_token('app') }}"><input type="hidden" name="branch" value="{{ branch.id }}">
                <div><label>Room number</label><input name="number" required></div>
                <div><label>Room type</label><select name="type" required><option value="Tryke Room">Tryke Room</option><option value="Standard Room">Standard Room</option></select></div>
                <div><label>Sleeps</label><input type="number" name="capacity" min="1" value="2"></div>
                <div><label>Nightly rate (₱)</label><input type="number" name="price" min="1" required></div>
                <div style="grid-column:1/-1"><label>Amenities (comma separated)</label><input name="amenities" placeholder="King bed, City view, Wi-Fi"></div>
                <div style="grid-column:1/-1"><label>Description</label><input name="description"></div>
                <div><button class="btn">Add room</button></div>
            </form>
        </details>
        {% endif %}
    </div>
</div>
{% endblock %}
